<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <!-- App icon / logo -->
    <ImageView
        android:id="@+id/iv_plex_logo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@id/tv_app_title"
        android:layout_marginBottom="16dp" />

    <!-- App name -->
    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Learn2Sing"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/iv_plex_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_plex_subtitle"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tv_plex_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect your Plex Media Server"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_app_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card_auth"
        android:layout_marginBottom="32dp" />

    <!-- Auth card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_auth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_plex_subtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <!-- Spinner -->
            <ProgressBar
                android:id="@+id/progress_plex"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="visible"
                android:layout_marginBottom="16dp" />

            <!-- Status message -->
            <TextView
                android:id="@+id/tv_plex_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connecting to Plex…"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- PIN code display -->
            <TextView
                android:id="@+id/tv_plex_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/accent_purple"
                android:letterSpacing="0.2"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_plex_code_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter this code in the browser if prompted"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="20dp" />

            <!-- Open browser button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_browser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open Plex in Browser"
                android:visibility="gone"
                android:layout_marginBottom="10dp"
                app:backgroundTint="@color/accent_purple" />

            <!-- Retry on error -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_plex_retry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Try Again"
                android:visibility="gone"
                app:backgroundTint="@color/bg_surface" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
